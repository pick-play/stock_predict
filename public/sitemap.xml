<?xml version="1.0" encoding="UTF-8"?>
<!--
  One URL, deliberately.

  The board and the chat room live behind #board and #chat, and a crawler drops
  the fragment before it fetches anything — so the two extra entries this file
  used to carry were both just https://kospinow.com/ again, submitted three
  times. Naver's Yeti and Google alike report those as duplicates rather than as
  pages. Making them separately indexable would mean real paths, which is a
  router change, not a sitemap one.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://kospinow.com/</loc>
    <changefreq>hourly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
